[{"data":1,"prerenderedAt":594},["ShallowReactive",2],{"page-/jp/contact":3,"page-/contact":33,"sanity-327r2IjF50":43,"sanity-JJozojyRM2":75,"sanity-5iVATSxM1j":558,"sanity-BhHQPHcbUY":570},{"_id":4,"_type":5,"formId":6,"globalSeo":7,"headline":11,"pageModules":11,"portalId":24,"seo":25,"slug":29,"title":32},"c07769aa-db2a-4d50-afa1-9b15b0bf1029","page","80f8dde5-328a-44bb-853f-45ce1a04c976",{"description":8,"image":9,"title":23},"A metal recycling technology that transforms contaminated, low‑value swarf into pristine, high‑value metal.",{"_type":10,"altText":11,"asset":12,"bgColor":15,"dimensions":16,"lqip":21,"originalFilename":22},"image",null,{"_ref":13,"_type":14},"image-af68131dee94ff0d793de9fad07eedf799d63a14-1200x630-jpg","reference","#1c140c",{"_type":17,"aspectRatio":18,"height":19,"width":20},"sanity.imageDimensions",1.9047619047619047,630,1200,"data:image/jpeg;base64,","seo-2.jpg","Turn your metal waste into revenue","24046691",{"_type":26,"image":11,"noindex":27,"title":28},"seo",false,"Contact",{"_type":30,"current":31},"slug","/jp/contact","お問い合わせ",{"_id":34,"_type":5,"formId":35,"globalSeo":36,"headline":11,"pageModules":11,"portalId":24,"seo":40,"slug":41,"title":28},"d3604a41-1255-43e1-afc4-7160c329a774","23b9249c-9fd1-418e-8985-897ff1621f23",{"description":8,"image":37,"title":23},{"_type":10,"altText":11,"asset":38,"bgColor":15,"dimensions":39,"lqip":21,"originalFilename":22},{"_ref":13,"_type":14},{"_type":17,"aspectRatio":18,"height":19,"width":20},{"_type":26,"image":11,"noindex":27,"title":28},{"_type":30,"current":42},"/contact",{"navItemsLeft":44,"navItemsRight":64},[45,52,57],{"_key":46,"_type":47,"entry":48,"text":51},"9ed5e493552a","navItem",{"slug":49,"title":50,"type":5},"/","Homepage","Home",{"_key":53,"_type":47,"entry":54,"text":56},"38312058d3dc",{"slug":55,"title":56,"type":5},"/company","Company",{"_key":58,"_type":47,"entry":59,"text":63},"105cbf14c7cb",{"slug":60,"title":61,"type":62},"/news","News Index","articleIndex","News",[65,72],{"_key":66,"_type":47,"entry":67,"text":71},"276c9dc24452",{"slug":68,"title":69,"type":70},"/careers","Job Posting – Index Page","careerIndex","Careers",{"_key":73,"_type":47,"entry":74,"text":28},"e81f8d1ffdf4",{"slug":42,"title":28,"type":5},{"_id":76,"_type":5,"globalSeo":77,"pageModules":81,"seo":554,"slug":556,"title":50},"70966905-8180-41d8-84af-1c41bfb3452f",{"description":8,"image":78,"title":23},{"_type":10,"altText":11,"asset":79,"bgColor":15,"dimensions":80,"lqip":21,"originalFilename":22},{"_ref":13,"_type":14},{"_type":17,"aspectRatio":18,"height":19,"width":20},[82,99,137,187,219,286,378,425,460,519],{"_key":83,"_type":84,"image":85,"layout":95,"splitText":96},"13d47591e12d","pageHeader",{"_type":10,"altText":11,"asset":86,"bgColor":88,"dimensions":89,"lqip":93,"originalFilename":94},{"_ref":87,"_type":14},"image-3d610bc33eba6d844dc99916cec634b3f9c48472-1020x954-png","#9d806a",{"_type":17,"aspectRatio":90,"height":91,"width":92},1.069182389937107,954,1020,"data:image/png;base64,","Aluminum Puck staright down on metal surface copy 2.png","homepage",{"leftText":97,"rightText":98},"Turn your metal waste","into revenue",{"_key":100,"_type":101,"blockText":102,"colorway":136},"085696c4113f","fullWidthText",[103,115,123,131],{"_key":104,"_type":105,"children":106,"markDefs":113,"style":114},"892a6aa13a61","block",[107],{"_key":108,"_type":109,"marks":110,"text":112},"46d78b75d6a1","span",[111],"strong","私たちは、金属リサイクルの常識を変えます。",[],"h2",{"_key":116,"_type":105,"children":117,"markDefs":122,"style":114},"1897769254ea",[118],{"_key":119,"_type":109,"marks":120,"text":121},"9a8bb02c7629",[],"金属を扱う現場では必ず金属屑が発生します。製造工程では全体の約20%が金属屑となり、床に散乱したり、廃棄容器に溜まったり、最悪の場合は埋立処分されることもあります。",[],{"_key":124,"_type":105,"children":125,"markDefs":130,"style":114},"10f1de66fdac",[126],{"_key":127,"_type":109,"marks":128,"text":129},"aaae865d50b2",[],"SUN METALONの技術は、発生したその場で金属屑をCO₂を排出せずにリサイクルし、新たな価値を生み出します。",[],{"_key":132,"_type":133,"entry":134,"icon":11,"markDefs":11,"scrollLink":27,"scrollTarget":11,"target":27,"text":135,"textLink":27,"url":11},"664569da9229","button",{"slug":42,"title":28,"type":5},"Contact Us","dark",{"_key":138,"_type":139,"benefits":140,"headline":176,"image":177},"c2fbafe8b047","benefits",[141,153,165],{"icon":142,"text":152},{"_type":10,"altText":11,"asset":143,"bgColor":145,"dimensions":146,"lqip":150,"originalFilename":151},{"_ref":144,"_type":14},"image-519e1041db16ed1eba79100f4ba7c74477b03f54-32x21-svg","#a16c54",{"_type":17,"aspectRatio":147,"height":148,"width":149},1.5238095238095237,21,32,"data:image/png;base64,","Group 30.svg","廃棄されていた金属屑を新たな資源へ",{"icon":154,"text":164},{"_type":10,"altText":11,"asset":155,"bgColor":157,"dimensions":158,"lqip":162,"originalFilename":163},{"_ref":156,"_type":14},"image-061a9aa27e0528875de80c47ec5c876adf6d3128-34x26-svg","#4d3529",{"_type":17,"aspectRatio":159,"height":160,"width":161},1.3076923076923077,26,34,"data:image/png;base64,","Group 31.svg","発生したその場でリサイクル",{"icon":166,"text":175},{"_type":10,"altText":11,"asset":167,"bgColor":169,"dimensions":170,"lqip":173,"originalFilename":174},{"_ref":168,"_type":14},"image-91910286bb6c95d4881622e595ee250f1ae13135-32x25-svg","#574036",{"_type":17,"aspectRatio":171,"height":172,"width":149},1.28,25,"data:image/png;base64,","Group 32.svg","あらゆる規模の金属屑に対応","The future of metal recycling ",{"_type":10,"altText":11,"asset":178,"bgColor":180,"dimensions":181,"lqip":185,"originalFilename":186},{"_ref":179,"_type":14},"image-e082088c7963bec0fcc6cd9b99378cff2e19081e-1388x1116-png","#524338",{"_type":17,"aspectRatio":182,"height":183,"width":184},1.2437275985663083,1116,1388,"data:image/png;base64,","stacked-pucks.png",{"_key":188,"_type":189,"blockText":190,"image":209},"2090236c81eb","centeredTextImage",[191,198],{"_key":192,"_type":105,"children":193,"markDefs":11,"style":197},"2869cafe9aa4",[194],{"_key":195,"_type":109,"text":196},"4ed44512b3b3","Introducing","label",{"_key":199,"_type":105,"children":200,"markDefs":11,"style":114},"4cab502910b9",[201,204],{"_key":202,"_type":109,"text":203},"2d23f1763c7a","Venus -L",{"_key":205,"_type":109,"marks":206,"text":208},"de024c2fc4b5",[207],"highlight","6",{"_type":10,"altText":11,"asset":210,"bgColor":212,"dimensions":213,"lqip":217,"originalFilename":218},{"_ref":211,"_type":14},"image-e53c35d729c3a6289b20cedd41f0e853e10f12b4-1514x1544-png","#c4c3c3",{"_type":17,"aspectRatio":214,"height":215,"width":216},0.9805699481865285,1544,1514,"data:image/png;base64,","venus-6.png",{"_key":220,"_type":221,"cards":222},"58a322a2612b","featureCards",[223,246,260,275],{"_key":224,"blockText":225,"bottomText":243,"cardType":244,"fontColor":245,"image":11,"topText":11},"e58a3c9d304a",[226,234],{"_key":227,"_type":105,"children":228,"markDefs":233,"style":114},"ebbb9e087df6",[229],{"_key":230,"_type":109,"marks":231,"text":232},"9656ba643a50",[],"Venusのご紹介",[],{"_key":235,"_type":105,"children":236,"markDefs":241,"style":242},"057c1cb7dfb9",[237],{"_key":238,"_type":109,"marks":239,"text":240},"18c94909fa38",[],"Venusは製造現場で発生する金属屑から油分や水分を取り除き、価値の高い金属資源に蘇らせることができます",[],"normal","製品紹介","text","white",{"_key":247,"blockText":11,"bottomText":248,"cardType":10,"fontColor":245,"image":249,"topText":259},"d7d2f04d7ae3","6つの加熱炉で金属屑をリサイクルするVenus-L6は\u003Cbr/>多くの鋳造、機械加工メーカー様に導入する場合に最適です",{"_type":10,"altText":11,"asset":250,"bgColor":252,"dimensions":253,"lqip":257,"originalFilename":258},{"_ref":251,"_type":14},"image-754b39718d17c81aafa4592053f2d95fd424e61d-1411x1703-png","#483a29",{"_type":17,"aspectRatio":254,"height":255,"width":256},0.8285378743394011,1703,1411,"data:image/png;base64,","card-1.png","On-site Units",{"_key":261,"blockText":11,"bottomText":262,"cardType":10,"fontColor":263,"image":264,"topText":274},"ee0316408582","水や油などの不純物が付着した金属ブリケットも、\u003Cbr/> 当社の技術で除去可能。\u003Cbr/>純度の高い金属として再利用できます","black",{"_type":10,"altText":11,"asset":265,"bgColor":267,"dimensions":268,"lqip":272,"originalFilename":273},{"_ref":266,"_type":14},"image-f217f86eb4759c66a05ae88f2dbdb1867d2352b6-1409x1700-png","#c4bcb4",{"_type":17,"aspectRatio":269,"height":270,"width":271},0.8288235294117647,1700,1409,"data:image/png;base64,","card-3.png","Dry Briquettes Produced",{"_key":276,"blockText":11,"bottomText":277,"cardType":10,"fontColor":263,"image":278,"topText":285},"1d6b5143e87f","SUN METALONの金属リサイクル工程は、CO₂を一切排出しません",{"_type":10,"altText":11,"asset":279,"bgColor":281,"dimensions":282,"lqip":283,"originalFilename":284},{"_ref":280,"_type":14},"image-7b2e8ddfeb80733f8a67b1148e723aed9b8eb91e-1409x1700-png","#6381b4",{"_type":17,"aspectRatio":269,"height":270,"width":271},"data:image/png;base64,","card-4.png","Zero-CO\u003Ci>2\u003C/i> emissions processing",{"_key":287,"_type":288,"blockText":289,"rows":298},"c393f0430e14","process",[290],{"_key":291,"_type":105,"children":292,"markDefs":297,"style":114},"50af1b407f31",[293],{"_key":294,"_type":109,"marks":295,"text":296},"e93a9b25692c",[],"アップサイクル用途\n",[],[299,320,341,359],{"_key":300,"blockText":301,"headline":310,"image":311},"31b1e4131fa3",[302],{"_key":303,"_type":105,"children":304,"markDefs":309,"style":242},"87a541f07cb4",[305],{"_key":306,"_type":109,"marks":307,"text":308},"0d479b3cd0c4",[],"金属を研磨する際に発生する研磨粉は、1kgあたりの価値がわずか数円程度にとどまることもあり、場合によっては処分にコストがかかることさえあります。\n",[],"研磨粉",{"_type":10,"altText":11,"asset":312,"bgColor":314,"dimensions":315,"lqip":318,"originalFilename":319},{"_ref":313,"_type":14},"image-935ddf0eb4d25d3ac596fff5418e2acc714d169e-1470x1700-png","#7c7c7c",{"_type":17,"aspectRatio":316,"height":270,"width":317},0.8647058823529412,1470,"data:image/png;base64,","Frame 4878.png",{"_key":321,"blockText":322,"headline":331,"image":332},"a3a42d7dae4d",[323],{"_key":324,"_type":105,"children":325,"markDefs":330,"style":242},"aed28f67da66",[326],{"_key":327,"_type":109,"marks":328,"text":329},"1887ffc32023",[],"研削工程などで発生する細かな切粉には、水や油性の潤滑剤が含まれているため、そのまま溶解炉に投入することができません。その結果、切粉や油分・水分を含んだ切粉を固形化しただけのブリケットは、大きく価値が下がってしまうことがあります。",[],"切粉",{"_type":10,"altText":11,"asset":333,"bgColor":335,"dimensions":336,"lqip":339,"originalFilename":340},{"_ref":334,"_type":14},"image-855be0d48c725b717762c6900542999dd8ad8d99-2205x2550-png","#444444",{"_type":17,"aspectRatio":316,"height":337,"width":338},2550,2205,"data:image/png;base64,","SM-Swarf2.png",{"_key":342,"blockText":343,"headline":352,"image":353},"569d679b87bd",[344],{"_key":345,"_type":105,"children":346,"markDefs":351,"style":242},"668b1971a4f8",[347],{"_key":348,"_type":109,"marks":349,"text":350},"458168c6f232",[],"CNC等の切削加工により発生した切削片を乾燥させ、油文・水分を含まない高品質ブリケットへと再生します。\n",[],"切削片",{"_type":10,"altText":11,"asset":354,"bgColor":335,"dimensions":356,"lqip":357,"originalFilename":358},{"_ref":355,"_type":14},"image-db612c8babba047276297a7c03794584a3adf7ee-1470x1700-jpg",{"_type":17,"aspectRatio":316,"height":270,"width":317},"data:image/jpeg;base64,","Chips.jpg",{"_key":360,"blockText":361,"headline":370,"image":371},"6044bda57aa0",[362],{"_key":363,"_type":105,"children":364,"markDefs":369,"style":242},"cf7819787106",[365],{"_key":366,"_type":109,"marks":367,"text":368},"9d3019946f1c",[],"旋盤加工で発生する金属くずは、長いもので数メートルにおよぶこともあり、絡み合ってまるでイバラのような状態になります。表面積が大きくてかさばるうえに、切削油や冷却水を多く含んでいるため、扱いが非常に厄介です。",[],"旋盤加工屑",{"_type":10,"altText":11,"asset":372,"bgColor":374,"dimensions":375,"lqip":376,"originalFilename":377},{"_ref":373,"_type":14},"image-35a27e9081850778f3344508ab2ba22b5e2ee19b-1470x1700-jpg","#c3c3c3",{"_type":17,"aspectRatio":316,"height":270,"width":317},"data:image/jpeg;base64,","Swarf.jpg",{"_key":379,"_type":380,"briquettes":381,"headline":420,"speedbump":421},"8e1d19e9583d","briquetteTypes",[382,396,408],{"_key":383,"gradient":384,"image":385,"selectorText":394,"text":395},"e991fdb807e6","silver",{"_type":10,"altText":11,"asset":386,"bgColor":388,"dimensions":389,"lqip":392,"originalFilename":393},{"_ref":387,"_type":14},"image-73ca82d3e97fd933d7ba06f35a898bcfdb590a81-1320x1320-png","#4c3729",{"_type":17,"aspectRatio":390,"height":391,"width":391},1,1320,"data:image/png;base64,","SM-Steel-Cutout - 2.png","鉄","SUN METALON のリサイクル技術は、さまざまな鉄、特殊鋼の金属屑リサイクルを可能にします。\n自動車や重機産業で発生する微細な研磨スラッジの場合でも、溶解歩留は90%を超えます。",{"_key":397,"gradient":398,"image":399,"selectorText":406,"text":407},"02a9e59b1b43","aluminum",{"_type":10,"altText":11,"asset":400,"bgColor":402,"dimensions":403,"lqip":404,"originalFilename":405},{"_ref":401,"_type":14},"image-df9030f0ebc3cbbee5f4539aec6fe14bec30c1a2-1320x1320-png","#050628",{"_type":17,"aspectRatio":390,"height":391,"width":391},"data:image/png;base64,","SM-Aluminum-Cutout - 2.png","アルミニウム","油分の多い切粉や低密度のブリケットを溶解しても、十分な溶解歩留は得られません。SUN METALONの技術を使用すれば、高価なインゴットや高品位スクラップに代わる材料として、90%前後の溶解歩留まりを期待できます。",{"_key":409,"gradient":410,"image":411,"selectorText":418,"text":419},"77b931b4f0ca","bronze",{"_type":10,"altText":11,"asset":412,"bgColor":414,"dimensions":415,"lqip":416,"originalFilename":417},{"_ref":413,"_type":14},"image-c58be2deb854b70005e5614247ab750ec55610b9-1320x1320-png","#54392d",{"_type":17,"aspectRatio":390,"height":391,"width":391},"data:image/png;base64,","SM-Bronze-Cutout - 2.png","銅・ニッケル","油分の多い軽金属の切屑や密度の低いブリケットの溶解では、期待した成果は得られません。SUN METALONのプロセスでは、高価なインゴットや高品位スクラップの代替となるブリケットを製造することで、溶融歩留まりを高めることが可能です。","The output? Reusable dry briquettes.",{"cta":422,"text":424},{"entry":423,"icon":11,"scrollLink":27,"scrollTarget":11,"target":11,"text":135,"textLink":11,"url":11},{"slug":42,"title":28,"type":5},"さらに詳しい情報をご希望の方は、お気軽にお問い合わせください ",{"_key":426,"_type":101,"blockText":427,"colorway":136},"ee1018344b0a",[428,436,444,452],{"_key":429,"_type":105,"children":430,"markDefs":435,"style":114},"d6c227bae9e5",[431],{"_key":432,"_type":109,"marks":433,"text":434},"e79026fba6bf",[111],"金属業界全体で、",[],{"_key":437,"_type":105,"children":438,"markDefs":443,"style":114},"4aba3964e6bf",[439],{"_key":440,"_type":109,"marks":441,"text":442},"5ca42c7f2d77",[],"製造中に最大20％の金属がその本来の価値を失っています。",[],{"_key":445,"_type":105,"children":446,"markDefs":451,"style":114},"32436cf99875",[447],{"_key":448,"_type":109,"marks":449,"text":450},"fda547257dee",[],"金属屑をただの廃棄物ではなく、資産として捉えるべきではないでしょうか。",[],{"_key":453,"_type":105,"children":454,"markDefs":459,"style":114},"a11c34668aee",[455],{"_key":456,"_type":109,"marks":457,"text":458},"8859028176b3",[],"SUN METALONのリサイクル技術なら、それを実現できます。",[],{"_key":461,"_type":462,"cards":463,"headline":518},"7ff0fe705a5b","stackingCards",[464,482,500],{"blockText":465},[466,474],{"_key":467,"_type":105,"children":468,"markDefs":473,"style":114},"2ff0da306482",[469],{"_key":470,"_type":109,"marks":471,"text":472},"1155daf49f8e",[],"金属資源としての再活用",[],{"_key":475,"_type":105,"children":476,"markDefs":481,"style":242},"d3c93d0fcc79",[477],{"_key":478,"_type":109,"marks":479,"text":480},"3638f2c25b9f",[],"製造工程で使用する金属原料のコストは、お客様が負担しています。しかし、大量の金属屑がほぼ無価値で取引され、場合によっては埋立処分されているのが現状です。貴重な資源をゴミとして扱うのは、もう終わりにしましょう。金属屑を回収・リサイクルし、収益向上へとつなげる。それがSUN METALONの提案です。",[],{"blockText":483},[484,492],{"_key":485,"_type":105,"children":486,"markDefs":491,"style":114},"a6cad400eaa6",[487],{"_key":488,"_type":109,"marks":489,"text":490},"4a7207433052",[],"材料調達の安定性",[],{"_key":493,"_type":105,"children":494,"markDefs":499,"style":242},"cf47720f20bb",[495],{"_key":496,"_type":109,"marks":497,"text":498},"78bade7fa5d4",[],"SUN METALONのリサイクル技術を導入することで、社内で金属屑を回収・リサイクル・再利用できるため、原材料調達の安定性を実現できます。",[],{"blockText":501},[502,510],{"_key":503,"_type":105,"children":504,"markDefs":509,"style":114},"87d62388a5f1",[505],{"_key":506,"_type":109,"marks":507,"text":508},"870953b12e7b",[],"よりサステナブルな世界へ",[],{"_key":511,"_type":105,"children":512,"markDefs":517,"style":242},"a0d9a628617f",[513],{"_key":514,"_type":109,"marks":515,"text":516},"4fff8b7cb572",[],"購入した金属資源を無駄にすることは、ビジネスだけではなく地球にも悪影響を及ぼします。SUN METALONのCO2排出を伴わないリサイクル技術を活用すれば、より多くの利益を確保するだけでなく、金属屑の廃棄を無くし、私たちの地球にかける過剰な負荷を低減できます。",[],"Benefits",{"_key":520,"_type":521,"articles":522,"button":548,"headline":552,"isManual":27,"showBriquettes":553},"2e068c11b3fc","linkList",[523,528,533,538,543],{"_id":524,"publishedAt":525,"slug":526,"title":527},"30247c4b-8561-4d9b-9c73-5901e57f90da","2026-01-09","/jp/news/featured-in-nikkei-breakthrough","1月10日（土）10時30分～放送のテレビ東京系列『日経スペシャル ブレイクスルー ～不屈なる開拓者～』に出演します",{"_id":529,"publishedAt":530,"slug":531,"title":532},"30f72880-91ad-45e7-9e8d-51e7ec4f484c","2025-11-25","/jp/news/featured-in-forbes-2025-japans-best-startup-employers","日本の起業家ランキング〈みずほ賞〉」において、SUN METALON代表取締役CEOの西岡が選出されました",{"_id":534,"publishedAt":535,"slug":536,"title":537},"f3f93bd2-6fc4-4422-ae08-e0a7fe4260f8","2025-10-06","/jp/news/featured-in-toyo-keizais-great-startups-list","週刊東洋経済「すごいベンチャー100」2025年最新版に選出されました",{"_id":539,"publishedAt":540,"slug":541,"title":542},"328464a6-f371-413b-9719-58b216855ac5","2025-08-25","/jp/news/joining-ms-salon-frontier-summit-hosted-by-mizuho-bank","みずほ銀行主催のM's Salon Frontier Summitに登壇します",{"_id":544,"publishedAt":545,"slug":546,"title":547},"42b74a71-9c56-4983-8b04-397a00d05ab2","2025-07-18","/jp/news/joining-a-panel-discussion-in-nagoya","名古屋市で開催されるイベント「モノづくり×スタートアップの“リアルな戦略”を聞ける夜」に登壇します",{"entry":549,"icon":11,"scrollLink":27,"scrollTarget":11,"target":27,"text":551,"textLink":27,"url":11},{"slug":550,"title":61,"type":62},"/jp/news","Read More","Latest News",true,{"_type":26,"description":555,"image":11,"noindex":27,"title":23},"私たちは、金属リサイクルの常識を変えます。 \n金属を扱う現場では必ず金属屑が発生します。製造工程では全体の約20%が金属屑となり、床に散乱したり、廃棄容器に溜まったり、最悪の場合は埋立処分されることもあります。\n\nSUN METALONの技術は、発生したその場で金属屑をCO₂を排出せずにリサイクルし、新たな価値を生み出します。",{"_type":30,"current":557},"/jp",{"active":553,"approve":559,"blockText":560,"deny":569},"Accept",[561],{"_key":562,"_type":105,"children":563,"markDefs":568,"style":242},"8e89fe1e5864",[564],{"_key":565,"_type":109,"marks":566,"text":567},"2fb152d4c3ba",[],"We use cookies to improve your experience.",[],"Deny",{"_id":571,"_type":571,"footerNav":572,"formId":592,"legalNav":11,"newsletterText":593,"portalId":24},"footer",[573,576,579,582,586],{"_key":574,"_type":47,"entry":575,"text":51},"f6a3ba6d8ba5",{"slug":49,"title":50,"type":5},{"_key":577,"_type":47,"entry":578,"text":56},"ff721de6b0ea",{"slug":55,"title":56,"type":5},{"_key":580,"_type":47,"entry":581,"text":63},"4fc4660fd40f",{"slug":60,"title":61,"type":62},{"_key":583,"_type":47,"target":553,"text":584,"url":585},"671b8ddc76d2","LinkedIn","https://www.linkedin.com/company/sunmetalon/",{"_key":587,"_type":47,"entry":588,"text":590},"f66509a37ecd",{"slug":589,"title":590,"type":591},"/legal/privacy-policy","Privacy Policy","legal","19b1b5e6-a192-4ce6-a74a-d340686bffe2","Sign up to receive our white paper, or to stay up to date on information about our products.",1776192821984]