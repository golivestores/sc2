","#9d806a",{"_type":17,"aspectRatio":130,"height":131,"width":132},1.069182389937107,954,1020,"data:image/png;base64,","Aluminum Puck staright down on metal surface copy 2.png",{"leftText":136,"rightText":137},"Turn your metal waste","into revenue",{"_key":139,"_type":140,"blockText":141,"colorway":178},"2f2c48be8044","fullWidthText",[142,152,173],{"_key":143,"_type":49,"children":144,"markDefs":150,"style":151},"79d450d462d2",[145],{"_key":146,"_type":53,"marks":147,"text":149},"d0e06e47e3ab",[148],"strong","We're redefining metal recycling.",[],"h2",{"_key":153,"_map":154,"_type":49,"children":158,"markDefs":172,"style":151},"c479a0104575",{"contentHash":155,"documentPath":156,"typePath":157},1813171483,"pageModules[_key:text1].blockText[_key:block1]","pageModules[_key:textAndMedia].blockText[_key:block]",[159,163,168],{"_key":160,"_type":53,"marks":161,"text":162},"a87a3fb880ad",[],"Working with metal comes with a downside: waste. As much as 20% of metal is wasted in manufacturing – with swarf ending up on floors, stored in waste containers or, even worse, in landfills. Sun Metalon’s technology recycles that waste into profit – all on-site with zero CO",{"_key":164,"_type":53,"marks":165,"text":167},"9a6ffdfa8b9d",[166],"subscript","2",{"_key":169,"_type":53,"marks":170,"text":171},"bd04ee63a54f",[]," emissions.",[],{"_key":174,"_type":175,"entry":176,"icon":11,"markDefs":11,"scrollLink":27,"scrollTarget":11,"target":27,"text":177,"textLink":27,"url":11},"2b533b8c00b5","button",{"slug":42,"title":28,"type":5},"Contact Us","dark",{"_key":180,"_type":181,"benefits":182,"headline":218,"image":219},"38c7188745f9","benefits",[183,195,207],{"icon":184,"text":194},{"_type":10,"altText":11,"asset":185,"bgColor":187,"dimensions":188,"lqip":192,"originalFilename":193},{"_ref":186,"_type":14},"image-519e1041db16ed1eba79100f4ba7c74477b03f54-32x21-svg","#a16c54",{"_type":17,"aspectRatio":189,"height":190,"width":191},1.5238095238095237,21,32,"data:image/png;base64,","Group 30.svg","Built for any size business",{"icon":196,"text":206},{"_type":10,"altText":11,"asset":197,"bgColor":199,"dimensions":200,"lqip":204,"originalFilename":205},{"_ref":198,"_type":14},"image-061a9aa27e0528875de80c47ec5c876adf6d3128-34x26-svg","#4d3529",{"_type":17,"aspectRatio":201,"height":202,"width":203},1.3076923076923077,26,34,"data:image/png;base64,","Group 31.svg","On-site recycling, no third-party vendors, no storage",{"icon":208,"text":217},{"_type":10,"altText":11,"asset":209,"bgColor":211,"dimensions":212,"lqip":215,"originalFilename":216},{"_ref":210,"_type":14},"image-91910286bb6c95d4881622e595ee250f1ae13135-32x25-svg","#574036",{"_type":17,"aspectRatio":213,"height":214,"width":191},1.28,25,"data:image/png;base64,","Group 32.svg","Effective at reclaiming what was once waste","The future of metal recycling ",{"_type":10,"altText":11,"asset":220,"bgColor":222,"dimensions":223,"lqip":227,"originalFilename":228},{"_ref":221,"_type":14},"image-e082088c7963bec0fcc6cd9b99378cff2e19081e-1388x1116-png","#524338",{"_type":17,"aspectRatio":224,"height":225,"width":226},1.2437275985663083,1116,1388,"data:image/png;base64,","stacked-pucks.png",{"_key":230,"_type":231,"blockText":232,"rows":249},"7e174560ebef","process",[233,241],{"_key":234,"_type":49,"children":235,"markDefs":240,"style":151},"37e49cf952f7",[236],{"_key":237,"_type":53,"marks":238,"text":239},"a47ed6ae2b6d",[148],"Metal Upcycling",[],{"_key":242,"_type":49,"children":243,"markDefs":248,"style":151},"7474707bb2dd",[244],{"_key":245,"_type":53,"marks":246,"text":247},"2ac47b3b95b6",[],"Applications",[],[250,272,297,318],{"_key":251,"blockText":252,"headline":261,"image":262},"5d255fb8ccf5",[253],{"_key":254,"_type":49,"children":255,"markDefs":260,"style":57},"52e330bbea5d",[256],{"_key":257,"_type":53,"marks":258,"text":259},"8977e355a2ee",[],"The polishing sludge produced in manufacturing stainless steel, specialty irons, and other metals is usually worth just pennies per pound or, even worse, cost you money to have disposed.",[],"Sludge",{"_type":10,"altText":11,"asset":263,"bgColor":265,"dimensions":266,"lqip":270,"originalFilename":271},{"_ref":264,"_type":14},"image-935ddf0eb4d25d3ac596fff5418e2acc714d169e-1470x1700-png","#7c7c7c",{"_type":17,"aspectRatio":267,"height":268,"width":269},0.8647058823529412,1700,1470,"data:image/png;base64,","Frame 4878.png",{"_key":273,"blockText":274,"headline":287,"image":288},"5802cec85d32",[275],{"_key":276,"_map":277,"_type":49,"children":281,"markDefs":286,"style":57},"74482ff267ff",{"contentHash":278,"documentPath":279,"typePath":280},2051377094,"pageModules[_key:accordion1].rows[_key:row2].blockText[_key:block1]","pageModules[_key:accordion].blockText[_key:block]",[282],{"_key":283,"_type":53,"marks":284,"text":285},"204d45b308dd",[],"Small chips and flakes from roll mills and grinding operations contain water or oil-based lubricants, meaning they can't be recharged directly into a melting furnace. And swarf or \"wet briquettes\" can be drastically devalued.",[],"Swarf",{"_type":10,"altText":11,"asset":289,"bgColor":291,"dimensions":292,"lqip":295,"originalFilename":296},{"_ref":290,"_type":14},"image-855be0d48c725b717762c6900542999dd8ad8d99-2205x2550-png","#444444",{"_type":17,"aspectRatio":267,"height":293,"width":294},2550,2205,"data:image/png;base64,","SM-Swarf2.png",{"_key":298,"blockText":299,"headline":311,"image":312},"6d715fe88626",[300],{"_key":301,"_map":302,"_type":49,"children":305,"markDefs":310,"style":57},"461ce2077f7b",{"contentHash":303,"documentPath":304,"typePath":280},1950876511,"pageModules[_key:accordion1].rows[_key:row3].blockText[_key:block1]",[306],{"_key":307,"_type":53,"marks":308,"text":309},"ef1201228493",[],"Machining on wrought and cast alloys produces chips a few millimeters wide and less than a millimeter thick, which the Metalon Process transforms into dry briquettes of known alloy.",[],"Chips",{"_type":10,"altText":11,"asset":313,"bgColor":291,"dimensions":315,"lqip":316,"originalFilename":317},{"_ref":314,"_type":14},"image-db612c8babba047276297a7c03794584a3adf7ee-1470x1700-jpg",{"_type":17,"aspectRatio":267,"height":268,"width":269},"data:image/jpeg;base64,","Chips.jpg",{"_key":319,"blockText":320,"headline":329,"image":330},"51773aab61be",[321],{"_key":322,"_type":49,"children":323,"markDefs":328,"style":57},"f206c2879380",[324],{"_key":325,"_type":53,"marks":326,"text":327},"97088d2d4e90",[],"Turnings from horizontal and vertical lathes range from a few centimeters up to several meters in length. These “brambles” possess very high surface area and low packing density while carrying a substantial load of liquid contaminants. Shredding, briquetting, and processing with Sun Metalon's equipment solves for all three issues.",[],"Turnings",{"_type":10,"altText":11,"asset":331,"bgColor":333,"dimensions":334,"lqip":335,"originalFilename":336},{"_ref":332,"_type":14},"image-35a27e9081850778f3344508ab2ba22b5e2ee19b-1470x1700-jpg","#c3c3c3",{"_type":17,"aspectRatio":267,"height":268,"width":269},"data:image/jpeg;base64,","Swarf.jpg",{"_key":338,"_type":339,"blockText":340,"image":363},"d916741ab3e4","centeredTextImage",[341,350],{"_key":342,"_type":49,"children":343,"markDefs":348,"style":349},"9abfa5166f8c",[344],{"_key":345,"_type":53,"marks":346,"text":347},"9520624613e2",[],"Introducing",[],"label",{"_key":351,"_type":49,"children":352,"markDefs":362,"style":151},"defe632444c1",[353,357],{"_key":354,"_type":53,"marks":355,"text":356},"5725559a69c4",[],"Venus -L",{"_key":358,"_type":53,"marks":359,"text":361},"31df0555d88e",[360],"highlight","6",[],{"_type":10,"altText":11,"asset":364,"bgColor":366,"dimensions":367,"lqip":371,"originalFilename":372},{"_ref":365,"_type":14},"image-e53c35d729c3a6289b20cedd41f0e853e10f12b4-1514x1544-png","#c4c3c3",{"_type":17,"aspectRatio":368,"height":369,"width":370},0.9805699481865285,1544,1514,"data:image/png;base64,","venus-6.png",{"_key":374,"_type":375,"cards":376},"c72afb9365d3","featureCards",[377,404,418,432],{"_key":378,"blockText":379,"bottomText":401,"cardType":402,"fontColor":403,"image":11,"topText":11},"602ae20baf72",[380,392],{"_key":381,"_map":382,"_type":49,"children":386,"markDefs":391,"style":151},"8e8358344529",{"contentHash":383,"documentPath":384,"typePath":385},-200206105,"pageModules[_key:cards1].blockText[_key:block1]","pageModules[_key:cardGrid].blockText[_key:block]",[387],{"_key":388,"_type":53,"marks":389,"text":390},"a5aa8dd238b8",[],"Introducing Venus",[],{"_key":393,"_map":394,"_type":49,"children":395,"markDefs":400,"style":57},"c69a116ec76a",{"contentHash":383,"documentPath":384,"typePath":385},[396],{"_key":397,"_type":53,"marks":398,"text":399},"3dd2d341683c",[],"A metal recycling technology that transforms contaminated, low-value swarf into pristine, high-value metal. ",[],"Product Specifications","text","white",{"_key":405,"blockText":11,"bottomText":406,"cardType":10,"fontColor":403,"image":407,"topText":417},"d28dab560a7f","The six-furnace Venus-L6 hits the sweet spot for many foundries and machine shops.",{"_type":10,"altText":11,"asset":408,"bgColor":410,"dimensions":411,"lqip":415,"originalFilename":416},{"_ref":409,"_type":14},"image-754b39718d17c81aafa4592053f2d95fd424e61d-1411x1703-png","#483a29",{"_type":17,"aspectRatio":412,"height":413,"width":414},0.8285378743394011,1703,1411,"data:image/png;base64,","card-1.png","On-site Units",{"_key":419,"blockText":11,"bottomText":420,"cardType":10,"fontColor":421,"image":422,"topText":431},"7fd95cb5e061","Contaminated metal pucks are recycled into clean, dry pucks, composed of the original alloy, that are ready for the melt pool.","black",{"_type":10,"altText":11,"asset":423,"bgColor":425,"dimensions":426,"lqip":429,"originalFilename":430},{"_ref":424,"_type":14},"image-f217f86eb4759c66a05ae88f2dbdb1867d2352b6-1409x1700-png","#c4bcb4",{"_type":17,"aspectRatio":427,"height":268,"width":428},0.8288235294117647,1409,"data:image/png;base64,","card-3.png","Dry Briquettes Produced",{"_key":433,"blockText":11,"bottomText":434,"cardType":10,"fontColor":421,"image":435,"topText":442},"51a10d482191","Sun Metalon's metal recycling process produces zero CO\u003Ci>2\u003C/i> emissions.",{"_type":10,"altText":11,"asset":436,"bgColor":438,"dimensions":439,"lqip":440,"originalFilename":441},{"_ref":437,"_type":14},"image-7b2e8ddfeb80733f8a67b1148e723aed9b8eb91e-1409x1700-png","#6381b4",{"_type":17,"aspectRatio":427,"height":268,"width":428},"data:image/png;base64,","card-4.png","Zero-CO\u003Ci>2\u003C/i> emissions processing",{"_key":444,"_type":445,"briquettes":446,"headline":485,"speedbump":486},"2da0f67e91d6","briquetteTypes",[447,461,473],{"_key":448,"gradient":449,"image":450,"selectorText":459,"text":460},"d6eac16b8290","silver",{"_type":10,"altText":11,"asset":451,"bgColor":453,"dimensions":454,"lqip":457,"originalFilename":458},{"_ref":452,"_type":14},"image-73ca82d3e97fd933d7ba06f35a898bcfdb590a81-1320x1320-png","#4c3729",{"_type":17,"aspectRatio":455,"height":456,"width":456},1,1320,"data:image/png;base64,","SM-Steel-Cutout - 2.png","Steel","Various steel and specialty iron alloys can be recycled using Sun Metalon's recycling technology. Melt yields exceeding 90 percent are common, even with the fine polishing sludge found in the automotive and heavy-equipment industries.",{"_key":462,"gradient":463,"image":464,"selectorText":471,"text":472},"e55ae9cf2a62","aluminum",{"_type":10,"altText":11,"asset":465,"bgColor":467,"dimensions":468,"lqip":469,"originalFilename":470},{"_ref":466,"_type":14},"image-df9030f0ebc3cbbee5f4539aec6fe14bec30c1a2-1320x1320-png","#050628",{"_type":17,"aspectRatio":455,"height":456,"width":456},"data:image/png;base64,","SM-Aluminum-Cutout - 2.png","Aluminum","Melting light, oily metal chips or low-density pucks can often prove ineffective. With Sun Metalon's technology, you can expect aluminum melt yields of up to 90 percent in the production of dry pucks that can replace expensive ingot or high-grade scrap.",{"_key":474,"gradient":475,"image":476,"selectorText":483,"text":484},"20a12efe2729","bronze",{"_type":10,"altText":11,"asset":477,"bgColor":479,"dimensions":480,"lqip":481,"originalFilename":482},{"_ref":478,"_type":14},"image-c58be2deb854b70005e5614247ab750ec55610b9-1320x1320-png","#54392d",{"_type":17,"aspectRatio":455,"height":456,"width":456},"data:image/png;base64,","SM-Bronze-Cutout - 2.png","Copper and Nickel","The Metalon Process enables copper alloy melt yields up to 90% while producing dry pucks that can replace expensive ingot or high-grade scrap.","The output? Reusable dry briquettes.",{"cta":487,"text":489},{"entry":488,"icon":11,"scrollLink":27,"scrollTarget":11,"target":11,"text":177,"textLink":11,"url":11},{"slug":42,"title":28,"type":5},"Stay in touch for more information.",{"_key":491,"_type":140,"blockText":492,"colorway":11},"60cbb6d2cfeb",[493,501,512],{"_key":494,"_type":49,"children":495,"markDefs":500,"style":151},"42a6d3393998",[496],{"_key":497,"_type":53,"marks":498,"text":499},"187153a7c7e2",[148],"Our mission is simple.",[],{"_key":502,"_map":503,"_type":49,"children":506,"markDefs":511,"style":151},"1c0c96a510a9",{"contentHash":504,"documentPath":505,"typePath":157},17716155,"pageModules[_key:text6].blockText[_key:block1]",[507],{"_key":508,"_type":53,"marks":509,"text":510},"61d31328e040",[],"Metal production is long overdue for a wake-up call. Today, across the industry, up to 20% of metal is lost during manufacturing. That's unacceptable. We believe you should stop treating your swarf like trash, and start treating it like an asset. Now, with Sun Metalon's recycling technology, you can.",[],{"_key":513,"_type":175,"entry":514,"icon":11,"markDefs":11,"scrollLink":27,"scrollTarget":11,"target":27,"text":515,"textLink":27,"url":11},"9892023e10e3",{"slug":71,"title":72,"type":5},"Our Company",{"_key":517,"_type":518,"cards":519,"headline":590},"258c9501ef39","stackingCards",[520,541,562],{"blockText":521},[522,530],{"_key":523,"_type":49,"children":524,"markDefs":529,"style":151},"ff190bed8c4c",[525],{"_key":526,"_type":53,"marks":527,"text":528},"2653ee323ff2",[],"Your Metal",[],{"_key":531,"_map":532,"_type":49,"children":535,"markDefs":540,"style":57},"1724f5bd800a",{"contentHash":533,"documentPath":534,"typePath":157},1110458482,"pageModules[_key:text7].blockText[_key:block1]",[536],{"_key":537,"_type":53,"marks":538,"text":539},"16d766c48eb9",[],"You pay for all the metal used in your manufacturing process. But a surprising amount  of that metal winds up as scrap, in waste bins, or in landfills. Stop tossing profit out the window – recapture and recycle your metal waste, and bolster your bottom line in the process. ",[],{"blockText":542},[543,551],{"_key":544,"_type":49,"children":545,"markDefs":550,"style":151},"bb42308122ed",[546],{"_key":547,"_type":53,"marks":548,"text":549},"da1d77f2fe51",[],"Your Independence",[],{"_key":552,"_map":553,"_type":49,"children":556,"markDefs":561,"style":57},"b7b2aa5d1084",{"contentHash":554,"documentPath":555,"typePath":157},-993196366,"pageModules[_key:text7].blockText[_key:block3]",[557],{"_key":558,"_type":53,"marks":559,"text":560},"833089bde0da",[],"Finally, you can control your own destiny when it comes to dealing with rapidly fluctuating steel and aluminum costs. Sun Metalon's proprietary technology allows you to recapture, recycle, and reuse your metal waste on-site and on your schedule, and with zero compromise in metal chemistry.",[],{"blockText":563},[564,572],{"_key":565,"_type":49,"children":566,"markDefs":571,"style":151},"ca27fcfe261d",[567],{"_key":568,"_type":53,"marks":569,"text":570},"c342a93536f5",[],"Your World",[],{"_key":573,"_map":574,"_type":49,"children":577,"markDefs":589,"style":57},"015a9c0d7021",{"contentHash":575,"documentPath":576,"typePath":157},-959550028,"pageModules[_key:text7].blockText[_key:block4]",[578,582,585],{"_key":579,"_type":53,"marks":580,"text":581},"ab9f8574d3fe",[],"Allowing the metal you buy to go to waste isn't just bad for business, it's bad for the planet. But it doesn't have to be that way. With Sun Metalon's CO",{"_key":583,"_type":53,"marks":584,"text":167},"9f552da00e60",[166],{"_key":586,"_type":53,"marks":587,"text":588},"bff668e38ca3",[],"-free recycling technology, you can keep contaminated metal swarf out of landfills – and keep more money in your pocket – while giving Mother Earth a much-needed break.",[],"Benefits",{"_key":592,"_type":593,"articles":594,"button":620,"headline":623,"isManual":27,"showBriquettes":44},"8b1352d2e2f0","linkList",[595,600,605,610,615],{"_id":596,"publishedAt":597,"slug":598,"title":599},"b8d01507-e879-4e92-b731-28fd136b40e2","2026-02-20","/news/colorado-invests-nearly-dollar1-million-in-sun-metalons-zero-emission-metal-recycling","Colorado Invests Nearly $1 Million in Sun Metalon's Zero-Emission Metal Recycling",{"_id":601,"publishedAt":602,"slug":603,"title":604},"a1227438-74cf-49a8-b207-e7d557df9862","2025-05-21","/news/pressrelease-2025-05","Sun Metalon Closes Series A Second Funding Round to Advance Decarbonization in the Metal Industry",{"_id":606,"publishedAt":607,"slug":608,"title":609},"Ri4WhEaMgLxsWY7GN8DtDv","2025-01-16","/news/sun-metalon-was-recently-presented-with-the-mizuho-innovation-award-20244q-sponsored-by-mizuho-bank","Sun Metalon was recently presented with the Mizuho Innovation Award 2024.4Q, sponsored by Mizuho Bank",{"_id":611,"publishedAt":612,"slug":613,"title":614},"VkC6YwtoohbJPwTdxEVzXa","2024-11-06","/news/sun-metalon-announces-relocation-of-headquarters-to-illinois","Sun Metalon Announces Relocation of Headquarters to Illinois",{"_id":616,"publishedAt":617,"slug":618,"title":619},"00IEvKAA7r4qq5Up6neNZy","2024-10-22","/news/sun-metalon-and-komatsu-launch-joint-research-on-innovative-recycling-process-for-iron-based-polishing-sludge","Sun Metalon and Komatsu Launch Joint Research on Innovative Recycling Process for Iron-based Polishing Sludge",{"entry":621,"icon":11,"scrollLink":27,"scrollTarget":11,"target":27,"text":622,"textLink":27,"url":11},{"slug":76,"title":77,"type":78},"Read More","Latest News",{"_type":26,"description":625,"image":626,"noindex":27,"title":636},"We’re redefining metal recycling. Working with metal comes with a downside: waste. As much as 20% of metal is wasted in manufacturing",{"_type":10,"altText":11,"asset":627,"bgColor":629,"dimensions":630,"lqip":634,"originalFilename":635},{"_ref":628,"_type":14},"image-05be112fc35d094fd006c0a00f9aa0519973bdd8-1546x910-png","#9e775c",{"_type":17,"aspectRatio":631,"height":632,"width":633},1.6989010989010989,910,1546,"data:image/png;base64,","Screenshot 2025-02-10 at 3.40.50 PM.png"," Turn your metal waste into revenue",{"_type":30,"current":65},1776192821984]